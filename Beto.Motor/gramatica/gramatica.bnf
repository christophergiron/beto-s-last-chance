# ============================================================================
#  Gramatica libre de contexto del proyecto
#
#  Formato:
#    <NOMBRE> ::= alternativa | alternativa
#    "texto"  = terminal (Ejemplo = <INVITACION>)
#    ""       = cadena vacia
#
#  El axioma S es la primera regla (<TEXTO_BETO>). Los simbolos de entrada que
#  usa el motor (INVITACION, INVITACION_ESTUDIO, MENSAJE_PROFESOR, MISION) son
#  alcanzables desde el axioma.
# ============================================================================

#Axioma
<TEXTO_BETO> ::= <RESUMEN_ESTUDIAR>
              | <RESUMEN_ESTUDIAR_AMIGOS>
              | <RESUMEN_SALIR>
              | <RESUMEN_PROYECTO>
              | <RESUMEN_DESCANSO>

#Estudiar
<RESUMEN_ESTUDIAR> ::= <MOMENTO_DIA> <TRABAJO_ESTUDIO> "."

# TRABAJO_ESTUDIO es recursiva: la ultima alternativa contiene otro trabajo de
# estudio entre parentesis ("... (y de paso ...)"). Cada nivel abre un
# parentesis que hay que cerrar despues, y eso hace el lenguaje no regular.
<TRABAJO_ESTUDIO> ::= "realizaste " <CANTIDAD> " ejercicios de " <MATERIA>
                   | "repasaste los apuntes de " <MATERIA>
                   | "leiste un capitulo de " <MATERIA>
                   | "practicaste " <TEMA> " en " <LUGAR_ESTUDIO>
                   | "avanzaste con " <TEMA> " (y de paso " <TRABAJO_ESTUDIO> ")"

#Estudiar con amigos
<RESUMEN_ESTUDIAR_AMIGOS> ::= <MOMENTO_DIA> "estudiaste " <MATERIA> " con " <GRUPO> " en " <LUGAR_ESTUDIO> "."
                           | <MOMENTO_DIA> "resolviste " <CANTIDAD> " ejercicios de " <MATERIA> " con " <GRUPO> "."
                           | <MOMENTO_DIA> "te juntaste con " <GRUPO> " a repasar " <TEMA> " en " <LUGAR_ESTUDIO> "."

#Salir con amigos
<RESUMEN_SALIR> ::= <MOMENTO_DIA> "saliste con " <GRUPO> " a " <PLAN> " en " <LUGAR> "."
                 | <MOMENTO_DIA> "te escapaste con " <GRUPO> " a " <PLAN> " en " <LUGAR> ", pero " <REMORDIMIENTO> "."

<REMORDIMIENTO> ::= "el tiempo se te fue volando"
                 | "los pendientes seguian ahi"
                 | "volviste tarde a casa"
                 | "ya empezaste a pensar en el examen"

#Proyecto
<RESUMEN_PROYECTO> ::= <MOMENTO_DIA> "trabajaste en el proyecto: " <AVANCE> "."
                    | <MOMENTO_DIA> "te quedaste hasta tarde con el proyecto: " <AVANCE> "."

<AVANCE> ::= "terminaste " <PARTE_PROYECTO>
          | "corregiste errores en " <PARTE_PROYECTO>
          | "avanzaste con " <PARTE_PROYECTO>

<PARTE_PROYECTO> ::= "la interfaz" | "la base de datos" | "la documentacion" | "las pruebas" | "el informe final"

#Descanso
<RESUMEN_DESCANSO> ::= <MOMENTO_DIA> <OCIO_SOLO> "."
                    | <MOMENTO_DIA> <OCIO_SOLO> ", y despues " <SENSACION> "."

<OCIO_SOLO> ::= "dormiste hasta tarde"
             | "viste videos sin parar"
             | "te quedaste mirando el techo"
             | "jugaste videojuegos solo en casa"
             | "no hiciste nada de provecho"

<SENSACION> ::= "te sentiste culpable" | "se te paso el tiempo" | "al menos descansaste"

#Vocabulario
<MOMENTO_DIA> ::= "Hoy " | "Por la manana " | "Por la tarde " | "Al caer la noche "

<CANTIDAD> ::= "5" | "8" | "10" | "12" | "15" | "20"
<MATERIA>  ::= "Calculo" | "Fisica" | "Programacion" | "Algebra" | "Bases de Datos"
<TEMA>     ::= "las derivadas" | "las integrales" | "la recursion" | "los punteros" | "las matrices"
<LUGAR_ESTUDIO> ::= "la biblioteca" | "la cafeteria" | "el aula 3" | "la sala de computo"

# Los grupos se escriben completos (sin recursion) para que un amigo nunca se
<GRUPO>  ::= <AMIGO> | <PAREJA> | <TRIO>
<AMIGO>  ::= "Pedro" | "Ana" | "Luis" | "Marta" | "Sofia"
<PAREJA> ::= "Pedro y Luis" | "Ana y Marta" | "Luis y Sofia" | "Pedro y Ana"
<TRIO>   ::= "Pedro, Luis y Ana" | "Ana, Marta y Sofia" | "Pedro, Ana y Sofia" | "Luis, Marta y Sofia"

<PLAN>  ::= "jugar" | "comer" | "pasear" | "ver una pelicula" | "tomar un cafe"
<LUGAR> ::= "la cafeteria" | "el parque" | "la cancha" | "el cine"