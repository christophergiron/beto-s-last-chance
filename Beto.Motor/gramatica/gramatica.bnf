# ============================================================================
#  Gramatica libre de contexto del proyecto
#
#  Formato:
#    <NOMBRE> ::= alternativa | alternativa
#    "texto"  = terminal (Ejemplo = <INVITACION>)
#    ""       = cadena vacia
#
#  El axioma S es la primera regla (<TEXTO_BETO>). Los simbolos de entrada que
#  usa el motor (INVITACION, INVITACION_ESTUDIO, MENSAJE_PROFESOR, MISION) son
#  alcanzables desde el axioma.
# ============================================================================

#Axioma
<TEXTO_BETO> ::= <INVITACION>
              | <INVITACION_ESTUDIO>
              | <MENSAJE_PROFESOR>
              | <MISION>

#Invitaciones de amigos
<INVITACION> ::= <AMIGO> " te invita a " <PLAN> " en " <LUGAR>
              | <PAREJA> " te invitan a " <PLAN> " en " <LUGAR> <HORA>
              | <AMIGO> " te escribe: " <FRASE_AMIGO>

<INVITACION_ESTUDIO> ::= <AMIGO> " propone estudiar " <MATERIA> " en " <LUGAR_ESTUDIO>
                      | <AMIGO> " te pide ayuda con " <TEMA> ", quedan en " <LUGAR_ESTUDIO>

<FRASE_AMIGO> ::= "Vamos a " <PLAN> " en " <LUGAR> ", te apuntas?"
               | "Hoy toca " <PLAN> "! Nos vemos en " <LUGAR> <HORA> "."

<AMIGO>  ::= "Pedro" | "Ana" | "Luis" | "Marta" | "Sofia"
<PAREJA> ::= "Pedro y Ana" | "Ana y Luis" | "Luis y Pedro" | "Marta y Sofia"
<PLAN>   ::= "jugar" | "comer" | "pasear" | "ver una pelicula" | "tomar un cafe"
<LUGAR>  ::= "la cafeteria" | "el parque" | "la cancha" | "el cine"
<LUGAR_ESTUDIO> ::= "la biblioteca" | "la cafeteria" | "el aula 3" | "la sala de computo"
<HORA>   ::= " despues de clases" | " al mediodia" | " a las cuatro" | " por la noche"

#Mensajes del profesor
<MENSAJE_PROFESOR> ::= <PROFESOR> " dice: " <AVISO>
                    | <PROFESOR> " te llama aparte: Beto, " <OBSERVACION> ", " <CONSEJO> "."
                    | <PROFESOR> " te encarga una mision: " <MISION>

<PROFESOR> ::= "El profesor Mendez" | "La profesora Ortiz" | "El ingeniero Salazar"

<AVISO> ::= "entreguen el proyecto " <FECHA> "."
         | "el examen final incluye " <TEMA> "."
         | "hay tutoria de " <MATERIA> " en " <LUGAR_ESTUDIO> " " <FECHA> "."

<OBSERVACION> ::= "te noto cansado"
               | "vas atrasado con el proyecto"
               | "faltaste a la ultima clase"
               | "vas bien con " <TEMA>

<CONSEJO> ::= "descansa un poco"
           | "repasa " <TEMA>
           | "pide ayuda a " <AMIGO>
           | "no dejes todo para el final"

<FECHA> ::= "el viernes" | "el lunes" | "esta semana" | "antes del dia 15"

#Misiones secundarias
#MISION es recursiva: las dos ultimas alternativas contienen otras misiones entre corchetes o parentesis balanceados.
<MISION> ::= "Consigue los apuntes de " <MATERIA> " con " <AMIGO>
          | "Repasa " <TEMA> " antes de " <MOMENTO>
          | "Resuelve " <CANTIDAD> " ejercicios de " <MATERIA>
          | "Para ayudar a " <AMIGO> ", primero cumple esto: (" <MISION> ")"
          | "Mision en dos pasos: [" <MISION> "] y luego [" <MISION> "]"

#Cosas varias
<MATERIA>  ::= "Calculo" | "Fisica" | "Programacion" | "Algebra Lineal"
<TEMA>     ::= "las derivadas" | "las integrales" | "la recursion" | "los punteros" | "las matrices"
<MOMENTO>  ::= "la entrega" | "que llegue el examen" | "la tutoria" | "que acabe la semana"
<CANTIDAD> ::= "tres" | "cinco" | "diez"